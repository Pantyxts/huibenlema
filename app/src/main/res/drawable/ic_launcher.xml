    <!-- 翻开的书（白色） -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,30c-7,-3.5 -15.5,-5.5 -25,-5.5c-3,0 -6,0.3 -9,0.9v46c3,-0.6 6,-0.9 9,-0.9c9.5,0 18,2 25,5.5z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,30c7,-3.5 15.5,-5.5 25,-5.5c3,0 6,0.3 9,0.9v46c-3,-0.6 -6,-0.9 -9,-0.9c-9.5,0 -18,2 -25,5.5z" />
    <!-- ¥ 符号（黑色，书页中央） -->
    <path
        android:strokeColor="#111111"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:pathData="M45,50 H63" />
    <path
        android:strokeColor="#111111"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:pathData="M48,57 H60" />
    <path
        android:strokeColor="#111111"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:pathData="M54,44 V63" />
    <path
        android:strokeColor="#111111"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:pathData="M49,38 L54,48 M59,38 L54,48" />
    <!-- 回本进度条：灰槽 + 白色填充（约 55%） -->
    <path
